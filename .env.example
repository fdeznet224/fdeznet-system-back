# Entorno
ENVIRONMENT=development

# Base de datos
DB_USER=fdeznet_dev
DB_PASSWORD=cambia-esta-clave
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=fdeznet_dev
# Alternativa: DATABASE_URL=mysql+asyncmy://usuario:password@host:3306/base
DB_POOL_RECYCLE=1800

# JWT: genera una con `openssl rand -hex 32`
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Orígenes separados por coma; nunca uses *
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_URL=http://localhost:5173

# Licencia y control de versiones. El servidor del propietario usa modo central.
FDEZNET_CONTROL_PLANE_MODE=client
FDEZNET_CONTROL_URL=https://fdezpay.com/api
FDEZNET_INSTALLATION_ID=
FDEZNET_LICENSE_KEY=
FDEZNET_RELEASE_VERSION=
FDEZNET_BACKEND_COMMIT=
FDEZNET_FRONTEND_COMMIT=

# Identidad inicial de una VPS nueva; el instalador la recibe del panel central.
FDEZNET_BRAND_NAME=
FDEZNET_BRAND_SYSTEM_NAME=
FDEZNET_BRAND_EMAIL=

# Debe ser idéntico en backend/.env y bot_whatsapp/.env
WEBHOOK_SECRET=
WHATSAPP_BASE_URL=http://127.0.0.1:3000

# Úsalas solo para crear el primer administrador y después elimínalas
ADMIN_BOOTSTRAP_USER=admin
ADMIN_BOOTSTRAP_NAME=Super Administrador
ADMIN_BOOTSTRAP_PASSWORD=

# WireGuard
WG_INTERFACE=wg0
WG_PORT=51820
WG_BIN=/usr/bin/wg
WG_QUICK_BIN=/usr/bin/wg-quick
SUDO_BIN=/usr/bin/sudo
VPN_SUBNET_BASE=10.8.0
VPN_SERVER_IP=
VPN_SERVER_PUBKEY=
